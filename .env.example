# Copia in .env e compila i valori

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/restaurant_ai

# AI
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Catena dei fornitori IA (facoltativa).
#
# Lasciando AI_PROVIDERS vuoto tutto funziona come sempre: solo Groq.
# Elencando piu' nomi si prova il primo, e quando finisce la quota giornaliera
# (429) si passa al successivo senza che il cliente se ne accorga.
# La chiave personale del ristoratore, se ce l'ha, viene comunque provata per
# prima: e' giusto consumare la sua quota gratuita prima della nostra.
#
# Per ogni NOME elencato si leggono NOME_API_KEY, NOME_URL e NOME_MODELS.
# Chi non ha la chiave viene saltato, quindi si possono lasciare le righe
# pronte e attivarle quando servono.
#
# AI_PROVIDERS=groq,cerebras
#
# CEREBRAS_API_KEY=csk_...
# CEREBRAS_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODELS=llama3.3-70b
#
# Funziona anche per un modello ospitato da noi (vLLM espone le stesse API):
# AI_PROVIDERS=groq,mio-vllm
# MIO_VLLM_API_KEY=non-serve-ma-va-riempita
# MIO_VLLM_URL=http://indirizzo-macchina:8000/v1
# MIO_VLLM_MODELS=Qwen3-32B

# Risposte alle recensioni Google (lo chiama Make.com)
# Finche' RECENSIONI_API_KEY e' vuota l'endpoint resta chiuso e risponde 401.
# Metti una stringa lunga e casuale: chi la conosce puo' spendere la tua quota IA.
RECENSIONI_API_KEY=
# Da quante stelle in su la risposta si pubblica da sola. Sotto, la deve
# leggere il ristoratore. 4 significa: 4 e 5 automatiche, 1-2-3 da approvare.
RECENSIONI_STELLE_AUTO=4

# Auth
JWT_SECRET=cambia_con_stringa_random_lunga_almeno_32_caratteri
SUPERADMIN_SECRET=segreto_per_creare_il_superadmin

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL (URL del tuo owner dashboard su Vercel)
APP_URL=https://tuo-owner-dashboard.vercel.app

# Twilio WhatsApp (opzionale)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886

# Server
PORT=3001
NODE_ENV=production

# Annunci da catalogo (Meta e TikTok) - vedi ISTRUZIONI-catalogo.md
# Chiave del feed: l'indirizzo del catalogo diventa
#   <API>/api/catalogo/meta.csv?k=<CATALOGO_KEY>
# Metti una stringa lunga e casuale. Finche' e' vuota il feed resta chiuso.
CATALOGO_KEY=
# API Conversioni Meta (facoltativa ma consigliata): ID del pixel e token
# generato in Gestione eventi > Impostazioni > API Conversioni.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Solo per provare: il codice "Test events" di Gestione eventi.
META_TEST_EVENT_CODE=
# Indirizzi pubblici usati nel catalogo (di solito non serve cambiarli)
CHAT_URL=https://menu.lingofork.com
API_PUBLIC_URL=https://ai-restaurant-assistant-production-449f.up.railway.app

# Quante domande al MODELLO puo' fare UN CLIENTE nella sua conversazione.
# E' il tetto vero. Tutto quello che risponde il database - piatti, prezzi,
# allergeni, ordini, saluti, fuori tema, consigli gia' in cache - non conta
# e non ha nessun limite. Zero = il modello non si tocca mai.
# Richiede la migrazione 027.
LIMITE_IA_CLIENTE=5

# Paracadute, non tetto: quante chiamate al modello puo' fare in un giorno
# UN RISTORANTE, tutti i suoi clienti insieme. Serve perche' i limiti dei
# piani gratuiti valgono per ORGANIZZAZIONE: senza questo un solo locale con
# tanti clienti brucia la quota di tutti gli altri. Tenerlo alto.
LIMITE_IA_GIORNO=200
LIMITE_IA_DEMO_GIORNO=200

# Per quanti giorni si conservano le conversazioni della chat.
# Dentro ci sono clienti che scrivono le proprie allergie: e' un dato
# sanitario e non ha senso tenerlo per sempre. Le statistiche (quante
# domande, di che tipo, in che lingua, quanti token) stanno aggregate in
# chat_intenti e consumi_ia e non vengono toccate dalla cancellazione.
# Sotto i 7 giorni il lavoro si rifiuta di cancellare, per sicurezza.
GIORNI_CONSERVAZIONE_CHAT=90
